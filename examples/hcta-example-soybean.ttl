ex:Hedge-0001 a hcta:HedgePosition ;
    hcta:hedges ex:Cargo-0001 ; hcta:hedgedExposure ex:T-Pur-Price ;
    hcta:hedgeInstrument ex:CBOT-Soybeans-May26 ; hcta:hedgeQuantity ex:T-HedgeQty .
ex:T-HedgeQty a hcta:QuantityTerm ; hcta:quantityValue 60000.0 ; hcta:unit "t" .

# -----------------------------------------------------------------------------
# Cross-standard concept mapping (seed)
# -----------------------------------------------------------------------------

ex:SC-FOSFA-WeightFinalDischarge a hcta:StandardConcept ;
    skos:prefLabel "Final at discharge (FOSFA form, illustrative)"@en ; hcta:definedIn ex:FOSFA-CFR-Form-E1 .
ex:SC-ANEC-WeightFinalLoading a hcta:StandardConcept ;
    skos:prefLabel "Final at loading (ANEC form, illustrative)"@en ; hcta:definedIn ex:ANEC-FOB-Form-E1 .

ex:Map-FOSFA-WeightFinality a hcta:ConceptMapping ;
    hcta:fromStandardConcept ex:SC-FOSFA-WeightFinalDischarge ; hcta:toCanonicalConcept hcta:WeightFinality ;
    hcta:matchKind skos:closeMatch ;
    hcta:semanticDifference "Illustrative: the standard's own rules on weighing method and tolerance apply on top of the canonical concept." .
ex:Map-ANEC-WeightFinality a hcta:ConceptMapping ;
    hcta:fromStandardConcept ex:SC-ANEC-WeightFinalLoading ; hcta:toCanonicalConcept hcta:WeightFinality ;
    hcta:matchKind skos:closeMatch .
