    hcta:validTime "2026-03-18T16:00:00Z"^^xsd:dateTime ; hcta:transactionTime "2026-03-19T08:30:00Z"^^xsd:dateTime ; hcta:factStatus hcta:Actual .

ex:Ev-WashoutA a hcta:Event ; hcta:eventType hcta:ContractWashedOut ; hcta:concernsCargo ex:Cargo-0001 ; hcta:concernsContract ex:SaleA ;
    hcta:validTime "2026-04-02T15:00:00Z"^^xsd:dateTime ; hcta:transactionTime "2026-04-02T15:10:00Z"^^xsd:dateTime ; hcta:factStatus hcta:Actual .

ex:Ev-ResaleB a hcta:Event ; hcta:eventType hcta:ResaleFixed ; hcta:concernsCargo ex:Cargo-0001 ; hcta:concernsContract ex:SaleB ;
    hcta:validTime "2026-04-02T15:00:00Z"^^xsd:dateTime ; hcta:transactionTime "2026-04-02T15:10:00Z"^^xsd:dateTime ; hcta:factStatus hcta:Actual .

ex:Ev-NORDischarge-Fc a hcta:Event ; hcta:eventType hcta:NORTenderedDischarge ; hcta:concernsCargo ex:Cargo-0001 ;
    hcta:validTime "2026-04-14T06:00:00Z"^^xsd:dateTime ; hcta:transactionTime "2026-04-02T15:30:00Z"^^xsd:dateTime ; hcta:factStatus hcta:Forecast .

ex:Ev-NORDischarge a hcta:Event ; hcta:eventType hcta:NORTenderedDischarge ; hcta:concernsCargo ex:Cargo-0001 ;
    hcta:concernsContract ex:SaleB , ex:CharterParty ;
    hcta:validTime "2026-04-16T09:30:00Z"^^xsd:dateTime ; hcta:transactionTime "2026-04-16T09:45:00Z"^^xsd:dateTime ; hcta:factStatus hcta:Actual ;
    hcta:supersedes ex:Ev-NORDischarge-Fc .

# -----------------------------------------------------------------------------
# Diagnostics raised by static passes
# -----------------------------------------------------------------------------

ex:Diag-Super a hcta:Diagnostic ;
    hcta:severity hcta:Warning ; hcta:diagnosticKind hcta:DoubleCostAllocation ;
    hcta:about ex:P-Pur-Superintendence , ex:P-SaB-Superintendence ;
    hcta:message "Load-port superintendence is borne by the origin entity under the purchase and by the branch under sale B: the group may pay it twice." ;
    hcta:raisedAt "2026-04-02T15:12:00Z"^^xsd:dateTime .

ex:Diag-Finality a hcta:Diagnostic ;
    hcta:severity hcta:Warning ; hcta:diagnosticKind hcta:FinalityMismatch ;
    hcta:about ex:P-Pur-WeightFinality , ex:P-SaB-WeightFinality ;
    hcta:message "Weight final at loading under the purchase but final at discharge under sale B: the branch carries outturn risk." ;
    hcta:raisedAt "2026-04-02T15:12:00Z"^^xsd:dateTime .

ex:Diag-Laytime a hcta:Diagnostic ;
    hcta:severity hcta:Warning ; hcta:diagnosticKind hcta:LaytimeMismatch ;
    hcta:about ex:P-CP-Laytime , ex:P-SaB-Laytime ;
    hcta:message "Charter party discharge rate 8,000 t/day at USD 18,000/day demurrage versus sale B 10,000 t/day at USD 14,000/day: demurrage paid to the owner is only partly recoverable." ;
    hcta:raisedAt "2026-04-02T15:12:00Z"^^xsd:dateTime .

# -----------------------------------------------------------------------------
# P&L evaluations
# -----------------------------------------------------------------------------

ex:PnL-Live-0416 a hcta:PnLEvaluation ;
    hcta:forCargo ex:Cargo-0001 ; hcta:pnlState hcta:LivePnL ;
    hcta:asKnownAt "2026-04-16T10:00:00Z"^^xsd:dateTime ;
    hcta:hasLine ex:Line-DemurrageGap , ex:Line-Washout .

ex:Line-DemurrageGap a hcta:PnLLine ;
    rdfs:label "Unrecoverable discharge demurrage (accrual)" ;
    hcta:lineAmount ex:Amt-DemGap ; hcta:explainedBy ex:P-CP-Laytime , ex:P-SaB-Laytime ;
    hcta:drivenBy ex:Ev-NORDischarge ; hcta:bookedTo ex:BranchGVA .
ex:Amt-DemGap a hcta:MoneyTerm ; hcta:amount -36000.0 ; hcta:currency "USD" .

ex:Line-Washout a hcta:PnLLine ;
    rdfs:label "Sale A washout settlement" ;
    hcta:lineAmount ex:Amt-Washout ; hcta:explainedBy ex:P-SaA-Washout ;
    hcta:drivenBy ex:Ev-WashoutA ; hcta:bookedTo ex:BranchGVA .
ex:Amt-Washout a hcta:MoneyTerm ; hcta:amount -120000.0 ; hcta:currency "USD" .

