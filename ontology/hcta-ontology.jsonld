    {
      "comment": {
        "@language": "en",
        "@value": "Reuses PROV-O for provenance, OWL-Time for temporal entities and SKOS for concept mapping. The domain model is the source of meaning; legacy systems are mapped to it, never the reverse."
      },
      "dcterms:created": {
        "@value": "2026-11-23",
        "type": "xsd:date"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "Core ontology for compiling physical commodity trading contracts into typed, linked holons attached to a unique cargo, and for computing P&L from them."
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Holonic Commodity Trading Architecture (HCTA) ontology"
      },
      "id": "https://example.org/hcta",
      "owl:versionInfo": "0.1.0",
      "type": "owl:Ontology"
    },
