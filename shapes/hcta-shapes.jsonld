      "sh:maxInclusive": 100,
      "sh:minInclusive": 0,
      "sh:path": {
        "id": "hcta:tolerancePercent"
      }
    },
    {
      "id": "hctash:ContractAttachmentShape",
      "sh:property": [
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb9"
        },
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb10"
        },
