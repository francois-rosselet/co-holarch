      }
    },
    {
      "comment": {
        "@language": "en",
        "@value": "I1: every contract is attached to at least one cargo, through a ContractAttachment."
      },
      "id": "hctash:ContractShape",
      "sh:property": [
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb6"
        },
