      "id": "_:n56f8635d132b463c9f7524abdedb13deb6",
      "sh:class": {
        "id": "hcta:ContractAttachment"
      },
      "sh:message": {
        "@language": "en",
        "@value": "I1 violated: contract is not attached to any cargo."
      },
      "sh:minCount": 1,
      "sh:path": {
        "id": "_:n56f8635d132b463c9f7524abdedb13deb7"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb7",
      "sh:inversePath": {
        "id": "hcta:attachedContract"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb8",
      "sh:datatype": {
        "id": "xsd:date"
      },
      "sh:maxCount": 1,
      "sh:path": {
        "id": "hcta:signedOn"
      }
    },
    {
      "comment": {
        "@language": "en",
        "@value": "I6: every incorporation is resolved to one edition, in force at the resolution date."
      },
      "id": "hctash:IncorporationShape",
      "sh:property": [
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb39"
        },
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb40"
        },
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb41"
        },
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb42"
        }
      ],
      "sh:sparql": [
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb43"
        },
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb44"
        }
      ],
      "sh:targetClass": {
        "id": "hcta:Incorporation"
      },
      "type": "sh:NodeShape"
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb39",
      "sh:class": {
        "id": "hcta:ReferenceText"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:referencedText"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb40",
      "sh:class": {
        "id": "hcta:Edition"
      },
      "sh:maxCount": 1,
      "sh:message": {
        "@language": "en",
        "@value": "I6 violated: incorporation not resolved to an edition."
      },
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:resolvedEdition"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb41",
      "sh:datatype": {
        "id": "xsd:date"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:resolutionDate"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb42",
      "sh:datatype": {
        "id": "xsd:positiveInteger"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:precedenceRank"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb43",
      "sh:message": {
        "@language": "en",
        "@value": "I6 violated: resolved edition is not an edition of the referenced text."
      },
      "sh:prefixes": {
        "id": "hctash:"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hcta:referencedText ?t ; hcta:resolvedEdition ?e .\n                FILTER NOT EXISTS { ?e hcta:editionOf ?t }\n            }"
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb44",
      "sh:message": {
        "@language": "en",
        "@value": "I6 violated: resolved edition was not in force at the resolution date."
      },
      "sh:prefixes": {
        "id": "hctash:"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hcta:resolvedEdition ?e ; hcta:resolutionDate ?d .\n                ?e hcta:effectiveFrom ?from .\n                OPTIONAL { ?e hcta:effectiveUntil ?until }\n                FILTER ( ?d < ?from || ( BOUND(?until) && ?d > ?until ) )\n            }"
    },
    {
      "id": "hctash:QuantityTermShape",
      "sh:property": [
        {
          "id": "_:n56f8635d132b463c9f7524abdedb13deb48"
        },
