        }
      ],
      "sh:targetClass": {
        "id": "hcta:ContractAttachment"
      },
      "type": "sh:NodeShape"
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb9",
      "sh:class": {
        "id": "hcta:Contract"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:attachedContract"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb10",
      "sh:class": {
        "id": "hcta:Cargo"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:attachedTo"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb11",
      "sh:datatype": {
        "id": "xsd:dateTime"
      },
      "sh:maxCount": 1,
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:attachedFrom"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb12",
      "sh:datatype": {
        "id": "xsd:dateTime"
      },
      "sh:maxCount": 1,
      "sh:path": {
        "id": "hcta:detachedAt"
      }
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb13",
      "sh:message": {
        "@language": "en",
        "@value": "A detached contract must state why it was detached."
      },
      "sh:prefixes": {
        "id": "hctash:"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hcta:detachedAt ?d .\n                FILTER NOT EXISTS { $this hcta:detachmentReason ?r }\n            }"
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb14",
      "sh:message": {
        "@language": "en",
        "@value": "A contract cannot be detached before it was attached."
      },
      "sh:prefixes": {
        "id": "hctash:"
      },
      "sh:select": "\n            SELECT $this WHERE {\n                $this hcta:attachedFrom ?f ; hcta:detachedAt ?d .\n                FILTER (?d < ?f)\n            }"
    },
    {
      "id": "hctash:NoLegacyKeyOnHolonShape",
      "sh:property": {
        "id": "_:n56f8635d132b463c9f7524abdedb13deb38"
