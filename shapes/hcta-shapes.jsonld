      }
    },
    {
      "comment": {
        "@language": "en",
        "@value": "I4: no holon may derive from an AI proposal that has not been validated."
      },
      "id": "hctash:UnvalidatedAIShape",
      "sh:sparql": {
        "id": "_:n56f8635d132b463c9f7524abdedb13deb32"
      },
      "sh:targetClass": {
        "id": "hcta:Holon"
      },
      "type": "sh:NodeShape"
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb32",
      "sh:message": {
        "@language": "en",
        "@value": "I4 violated: holon derives from an AI proposal that was never validated."
      },
      "sh:prefixes": {
        "id": "hctash:"
      },
      "sh:select": "\n            SELECT $this ?value WHERE {\n                $this prov:wasDerivedFrom ?value .\n                ?value a hcta:AIProposal .\n                FILTER NOT EXISTS { ?value hcta:validatedBy ?v }\n            }"
    },
    {
