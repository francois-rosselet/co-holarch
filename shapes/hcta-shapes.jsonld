      },
      "type": "sh:NodeShape"
    },
    {
      "id": "_:n56f8635d132b463c9f7524abdedb13deb3",
      "sh:datatype": {
        "id": "xsd:string"
      },
      "sh:maxCount": 1,
      "sh:message": {
        "@language": "en",
        "@value": "A holon must have exactly one holonId."
      },
      "sh:minCount": 1,
      "sh:path": {
        "id": "hcta:holonId"
      }
    },
    {
      "id": "hctash:MoneyTermShape",
      "sh:property": {
        "id": "_:n56f8635d132b463c9f7524abdedb13deb52"
      },
      "sh:targetClass": {
